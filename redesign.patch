+<meta charset="UTF-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
+<title>Tag Printer — Version 1 QR Generator</title>
+<meta name="theme-color" content="#EFE6D0" />
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
+<style>
+  :root{
+    --paper:#EFE6D0;
+    --backdrop:#E3D7B8;
+    --card:#FBF8EF;
+    --ink:#211D17;
+    --ink-soft:#7A705C;
+    --stamp:#2B4C7E;
+    --stamp-ink:#1F3A61;
+    --void:#B23A2E;
+    --void-ink:#8C2E24;
+    --line:#C9BFA0;
+    --line-strong:#B4A986;
+  }
+
+  *{ box-sizing:border-box; }
+  html,body{ height:100%; }
+  body{
+    margin:0;
+    background:var(--backdrop);
+    color:var(--ink);
+    font-family:'Inter',sans-serif;
+    display:flex;
+    justify-content:center;
+    -webkit-font-smoothing:antialiased;
+  }
+  .mono{ font-family:'IBM Plex Mono',monospace; }
+
+  /* ---------- Phone shell ---------- */
+  .phone{
+    width:100%;
+    max-width:430px;
+    min-height:100dvh;
+    background:var(--paper);
+    display:flex;
+    flex-direction:column;
+    position:relative;
+  }
+  @media (min-width:640px){
+    body{ padding:40px 20px; align-items:center; }
+    .phone{
+      height:860px;
+      min-height:0;
+      border-radius:44px;
+      overflow:hidden;
+      box-shadow:0 40px 80px -30px rgba(20,15,5,.55), 0 0 0 10px #17130f, 0 0 0 11px #000;
+    }
+    .notch{
+      position:absolute; top:14px; left:50%; transform:translateX(-50%);
+      width:120px; height:26px; background:#17130f; border-radius:20px; z-index:30;
+    }
+  }
+  .notch{ display:none; }
+  @media (min-width:640px){ .notch{ display:block; } }
+
+  /* ---------- App bar ---------- */
+  .app-bar{
+    flex:none;
+    padding:22px 20px 16px;
+    background:var(--paper);
+    position:relative;
+    z-index:10;
+  }
+  @media (min-width:640px){ .app-bar{ padding-top:42px; } }
+  .app-bar .eyebrow{
+    font-size:11px; letter-spacing:.14em; font-weight:600;
+    color:var(--stamp); text-transform:uppercase;
+    display:flex; align-items:center; gap:8px;
+  }
+  .app-bar .eyebrow .dot{
+    width:6px; height:6px; border-radius:50%; background:var(--stamp);
+  }
+  .app-bar h1{
+    font-family:'IBM Plex Mono',monospace;
+    font-size:22px; font-weight:600; margin:6px 0 0; letter-spacing:-.01em;
