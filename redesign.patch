+<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4">
+
+  <div class="max-w-md w-full bg-slate-800 rounded-2xl shadow-2xl border border-slate-700 p-6 space-y-6">
+    <!-- Header -->
+    <div class="border-b border-slate-700 pb-4">
+      <h1 class="text-xl font-bold text-white flex items-center gap-2">
+        <span>⚡</span> Version 1 QR Generator
+      </h1>
+      <p class="text-xs text-slate-400 mt-1">
+        Strict 21×21 Matrix Spec (Alphanumeric Optimized)
+      </p>
+    </div>
+
+    <!-- Form Inputs -->
+    <form id="qr-form" class="space-y-4" onsubmit="return false;">
+      <div>
+        <label for="qr-input" class="block text-sm font-medium text-slate-300 mb-1">
+          Payload / Data
+        </label>
+        <input 
+          type="text" 
+          id="qr-input" 
+          placeholder="e.g. EM12967120 or https://a.co"
+          class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition"
+          value="EM12967120"
+        />
+        <div class="flex justify-between items-center mt-1">
+          <span id="char-count" class="text-xs text-slate-500">10 chars</span>
+          <span id="mode-badge" class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-indigo-950 text-indigo-300 border border-indigo-800">
+            Mode: AUTO
+          </span>
+        </div>
+      </div>
+
+      <!-- Settings Grid -->
+      <div class="grid grid-cols-2 gap-3">
+        <div>
+          <label class="block text-xs font-medium text-slate-400 mb-1">Error Correction</label>
+          <select id="ec-level" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
+            <option value="L" selected>L (~7% capacity)</option>
+            <option value="M">M (~15% capacity)</option>
+            <option value="Q">Q (~25% capacity)</option>
+            <option value="H">H (~30% capacity)</option>
+          </select>
+        </div>
+        <div>
+          <label class="block text-xs font-medium text-slate-400 mb-1">Version Mode</label>
+          <select id="version-mode" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
+            <option value="1" selected>Strict V1 (21x21)</option>
+            <option value="auto">Auto-Scale if needed</option>
+          </select>
+        </div>
+      </div>
+
+      <!-- Generate Action Button -->
+      <button 
+        type="submit"
+        id="generate-btn" 
+        class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-2.5 rounded-lg text-sm transition shadow-lg shadow-indigo-600/20 active:scale-[0.99]"
+      >
+        Generate QR Code
+      </button>
+    </form>
+
+    <!-- Error Alert Banner -->
+    <div id="error-banner" class="hidden bg-rose-950/50 border border-rose-800/80 rounded-lg p-3 text-xs text-rose-300">
+      ⚠️ <span id="error-text">Payload exceeds Version 1 capacity limit!</span>
+    </div>
+
+    <!-- Canvas Preview Area -->
+    <div class="flex flex-col items-center justify-center p-6 bg-slate-900/50 rounded-xl border border-slate-700/50 min-h-[260px]">
+      <canvas id="qr-canvas" class="rounded-lg shadow-lg bg-white p-3 hidden"></canvas>
+      <div id="placeholder" class="text-center text-slate-500 text-xs">
+        Enter data and click "Generate QR Code"
+      </div>
+    </div>
+
+    <!-- Download PNG Button -->
+    <button 
+      id="download-btn" 
+      disabled
+      class="w-full bg-slate-700 hover:bg-slate-600 disabled:opacity-50 disabled:cursor-not-allowed text-white font-medium py-2.5 rounded-lg text-sm transition"
+    >
+      Download PNG
+    </button>
+  </div>
+
+  <script>
+    const input = document.getElementById('qr-input');
+    const ecLevel = document.getElementById('ec-level');
+    const versionMode = document.getElementById('version-mode');
+    const generateBtn = document.getElementById('generate-btn');
+    const canvas = document.getElementById('qr-canvas');
+    const placeholder = document.getElementById('placeholder');
+    const downloadBtn = document.getElementById('download-btn');
+    const errorBanner = document.getElementById('error-banner');
+    const errorText = document.getElementById('error-text');
+    const charCount = document.getElementById('char-count');
+    const modeBadge = document.getElementById('mode-badge');
+
+    // QR Alphanumeric validation pattern (0-9, A-Z, space, $, %, *, +, -, ., /, :)
+    const ALPHANUMERIC_REGEX = /^[0-9A-Z $%*+\-./:]+$/;
+
+    // Update input character count on typing
+    input.addEventListener('input', () => {
+      const text = input.value.trim().toUpperCase();
+      charCount.textContent = `${text.length} chars`;
+      
+      const isAlphanumeric = ALPHANUMERIC_REGEX.test(text);
+      modeBadge.textContent = `Mode: ${text ? (isAlphanumeric ? 'Alphanumeric' : 'Byte') : 'AUTO'}`;
+    });
+
+    function generateQR() {
+      const text = input.value.trim().toUpperCase(); 
+
+      if (!text) {
+        canvas.classList.add('hidden');
+        placeholder.classList.remove('hidden');
+        placeholder.textContent = 'Please enter payload data first.';
+        errorBanner.classList.add('hidden');
+        downloadBtn.disabled = true;
+        return;
+      }
+
+      const isAlphanumeric = ALPHANUMERIC_REGEX.test(text);
+
+      const config = {
+        errorCorrectionLevel: ecLevel.value,
+        margin: 4,
+        scale: 10,
+        color: {
+          dark: '#000000',
+          light: '#FFFFFF'
+        }
